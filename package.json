{
  "name": "boost-circuit",
  "version": "1.17.0",
  "private": true,
  "type": "module",
  "description": "Original browser-native car soccer inspired by researched arena-soccer mechanics",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "server": "node server/index.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "cloudflare:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cloudflare:deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "8.23.0"
  },
  "devDependencies": {
    "miniflare": "4.20260730.0",
    "wrangler": "4.161.0"
  }
}
