{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flyingcarsforfun",
  "main": "server/cloudflare-worker.mjs",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ARENA",
        "class_name": "ArenaService"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ArenaService"
      ]
    }
  ],
  "vars": {
    "MAX_ROOMS": "1",
    "ALLOWED_ORIGINS": "https://boost-circuit-arena.bobistheman2049.chatgpt.site"
  },
  "observability": {
    "enabled": false
  },
  "upload_source_maps": false
}
